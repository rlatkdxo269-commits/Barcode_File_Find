<Window x:Class="Barcode_File_Find.FileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일 선택" Height="300" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="여러 파일이 발견되었습니다. 하나를 선택해 주세요." FontWeight="Bold" Margin="0,0,0,10"/>
        <ListBox x:Name="FilesListBox" Grid.Row="1" Margin="0,0,0,10" MouseDoubleClick="FilesListBox_MouseDoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="열기" Width="75" Margin="0,0,10,0" Click="OpenButton_Click"/>
            <Button Content="취소" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
